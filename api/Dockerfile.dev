# Development Dockerfile
FROM node:18-alpine

WORKDIR /app

# Install tsx globally for hot reload
RUN npm install -g tsx

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start in development mode with hot reload
CMD ["npm", "run", "dev"]
